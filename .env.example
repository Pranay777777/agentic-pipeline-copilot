# Copy to .env and fill in. NEVER commit .env.
APP_ENV=local
LOG_LEVEL=INFO

# Example service config
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Model provider for the agents (ADR-004) - a free key from openrouter.ai/keys
OPENROUTER_API_KEY=
# LLM_MODEL=openrouter/free
# Or Google AI Studio's free Gemini API (OpenAI-compatible endpoint):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=<key from aistudio.google.com>
# LLM_MODEL=gemini-3.8-flash
# LLM_FALLBACK_MODELS=model-a:free,model-b:free   # tried in order when LLM_MODEL is rate limited
# LLM_MAX_TOKENS=8000          # room for a reasoning model's thinking + the answer
# LLM_REASONING_EFFORT=low      # low | medium | high | empty to send nothing

# Agents and sandbox (ADR-005)
# CORRECTION_MAX_ROUNDS=2
# SANDBOX_IMAGE=copilot-sandbox:0.2
# SANDBOX_TIMEOUT_S=240
# SANDBOX_MEMORY=2g
# SANDBOX_CPUS=2.0

# Pull requests (ADR-006): a fine-grained token for PR_REPO only -
# Contents read/write + Pull requests read/write. The copilot never merges.
# PR_REPO=owner/copilot-playground
# COPILOT_GITHUB_TOKEN=
# PR_BASE_BRANCH=main

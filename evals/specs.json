    {
      "id": "orders-dedup-1",
      "spec": "Load orders incrementally into Silver, one row per order_id, newest wins",
      "expect": {
        "strategy": "dedup_latest",
        "layer": "silver",
        "sources": [
          "orders"
        ],
        "keys": [
          "order_id"
        ]
      }
    },
